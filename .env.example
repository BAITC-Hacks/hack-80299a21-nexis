# Only backend reads this file. Never place credentials in frontend or Git.
EKT_API_BASE=https://ekt.kz/api
EKT_API_USER=
EKT_API_PASS=

# Optional: without a key, the same live catalog works through deterministic rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

HOST=127.0.0.1
PORT=8000
# Public URL used for the read-only cart links. Set to the deployed HTTPS origin.
# Docker Compose overrides this with NEXIS_PUBLIC_URL (default http://localhost:5173).
# NEXIS_PUBLIC_URL=https://your-public-frontend.example
BACKEND_PUBLIC_URL=http://localhost:8000
# Optional extra exact origins, comma-separated. localhost:3000 and :5173 always allowed.
CORS_ORIGINS=

EKT_CATALOG_PAGES=4
EKT_CATALOG_TTL_SECONDS=300
EKT_DETAIL_TTL_SECONDS=30
SESSION_TTL_SECONDS=86400
OFFER_TTL_SECONDS=600
REQUESTS_PER_MINUTE=60

# Optional absolute SQLite path. Default: database/nexis.sqlite3 in this repository.
# NEXIS_DB_PATH=C:/path/to/nexis.sqlite3

# Optional path to an installed Tesseract executable. Languages: rus, eng, kaz.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
